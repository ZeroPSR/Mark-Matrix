{
  "name": "mark-matrix",
  "version": "0.1.0",
  "private": true,
  "description": "Mark-Matrix — online result processing and distribution system.",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check-db": "tsx scripts/check-db.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "db:seed:admin": "tsx scripts/seed-admin.ts",
    "db:seed:test-users": "tsx scripts/seed-test-users.ts",
    "test:integration": "pnpm -r test",
    "test:rls": "cross-env SUPABASE_TEST_RLS=1 pnpm --filter @mark-matrix/api test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.14.0",
    "pg": "^8.23.0",
    "prettier": "^3.4.2",
    "supabase": "^1.200.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
