{
  // Cloudflare Workers config for the Mark-Matrix Hono API.
  // Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mark-matrix-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1.0 },
  "vars": { "ENVIRONMENT": "production" },
  // Cycle 8c: KV namespace for the rate-limit middleware.
  // Run `wrangler kv:namespace create RATE_LIMIT` to get the id, then paste it here.
  "kv_namespaces": [
    { "binding": "RATE_LIMIT", "id": "2229c5c5c3264d5a809f6d3993301e48" }
  ],
  // Cycle 8c: custom domain. Add a routes block here when the real domain
  // is set up on Cloudflare. Omit for now to use the default workers.dev URL.
  // "routes": [
  //   { "pattern": "api.mark-matrix.example.com/*", "zone_name": "mark-matrix.example.com" }
  // ],
  // Cycle 8c: structured log stream to the destination configured in the
  // Cloudflare dashboard (R2 / Datadog / S3 / HTTP endpoint).
  "logpush": true,
  "environments": {
    "dev": { "vars": { "ENVIRONMENT": "dev" } }
  }
}
