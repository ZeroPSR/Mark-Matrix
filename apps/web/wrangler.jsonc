{
  // Cloudflare Pages config for the React frontend.
  // Build output is produced by Vite; this file is consumed by @cloudflare/vite-plugin.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mark-matrix-web",
  "compatibility_date": "2025-09-23",
  "pages_build_output_dir": "./dist",
  "observability": { "enabled": true },
  // Cycle 8c: VITE_API_ORIGIN is inlined into the build at compile time.
  // Paste the real API host. For now using the workers.dev URL the API
  // was deployed to; replace with the custom domain when it's set up.
  "vars": {
    "VITE_API_ORIGIN": "https://mark-matrix-api.team-tractor.workers.dev"
  }
}
